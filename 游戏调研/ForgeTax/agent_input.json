  "design_principles": [
    {
      "id": "P01",
      "mechanism_refs": [
        "M02",
        "M04"
      ],
      "causal_chain": "可见累积资产和下一步风险加上兑现出口，使玩家能主动选择继续或停手。",
      "dependencies": [
        "信息可理解",
        "兑现有用途"
      ],
      "counterfactual": "没有兑现出口时继续可能变成必做；没有可理解信息时可能成为盲抽。",
      "claim_refs": [
        "C43"
      ]
    },
    {
      "id": "P02",
      "mechanism_refs": [
        "M03"
      ],
      "causal_chain": "危险状态中的准备，换来暂时不同的损失规则，可能让同一输入在窗口前后形成节奏变化。",
      "dependencies": [
        "状态与结束可辨识",
        "窗口改变规则"
      ],
      "counterfactual": "始终免失败会移除前段张力；窗口只换演出则难以改变决策。",
      "claim_refs": [
        "C44"
      ]
    },
    {
      "id": "P03",
      "mechanism_refs": [
        "M04",
        "M05"
      ],
      "causal_chain": "同一资产有不同估值和用途，迫使现在兑现、储备和投资后续能力竞争。",
      "dependencies": [
        "真实机会成本",
        "用途收益不完全等价"
