  "claims": [
    {
      "id": "C01",
      "text": "分析对象为用户确认的GraveYardDev开发的Steam Windows单人游戏ForgeTax，App ID 5245810。",
      "status": "fact",
      "source_refs": [
        "S01"
      ],
      "reasoning": null
    },
    {
      "id": "C02",
      "text": "官方流程包括拿剑加热、放到铁砧锻造、将剑用于贡品或遗物兑换。",
      "status": "fact",
      "source_refs": [
        "S01"
      ],
      "reasoning": null
    },
    {
      "id": "C03",
      "text": "社区操作资料记录移动、观察、E交互与左键敲击；官方提示区分E带剑离开和右键留剑。",
      "status": "fact",
      "source_refs": [
        "S11",
        "S03"
      ],
      "reasoning": null
    },
    {
      "id": "C04",
      "text": "社区基础判定资料记录Success使剑升1级。",
      "status": "fact",
      "source_refs": [
        "S13"
      ],
      "reasoning": null
    },
    {
      "id": "C05",
      "text": "社区基础判定资料记录Great使剑升2级。",
      "status": "fact",
      "source_refs": [
        "S13"
      ],
      "reasoning": null
    },
    {
      "id": "C06",
      "text": "社区基础判定资料记录Hold为停滞结果，可触发条件效果。",
      "status": "fact",
      "source_refs": [
        "S13"
      ],
      "reasoning": null
    },
    {
      "id": "C07",
      "text": "社区基础判定资料记录Damage降低1级且不低于+0。",
      "status": "fact",
      "source_refs": [
        "S11",
        "S13"
      ],
      "reasoning": null
    },
    {
      "id": "C08",
      "text": "社区资料记录Break毁坏剑，保护或恢复能力可以改写后果。",
      "status": "fact",
      "source_refs": [
        "S13",
        "S05"
      ],
      "reasoning": null
    },
    {
      "id": "C09",
      "text": "官方说明铁砧显示下一锤最终概率，票数显示用于区分条件修改。",
      "status": "fact",
      "source_refs": [
        "S06"
      ],
      "reasoning": null
    },
    {
      "id": "C10",
      "text": "10月6日官方把Great价值倍率改为2.5倍。",
      "status": "fact",
      "source_refs": [
        "S04"
      ],
      "reasoning": null
    },
    {
      "id": "C11",
      "text": "10月6日官方将强化上限提高到+99，外观到+20后不再新增。",
      "status": "fact",
      "source_refs": [
        "S04"
      ],
      "reasoning": null
    },
    {
      "id": "C12",
      "text": "官方常规描述为同剑锻造10次充满入神，下一次敲击触发短暂不会碎剑的状态。",
      "status": "fact",
      "source_refs": [
        "S01"
      ],
      "reasoning": null
    },
    {
      "id": "C13",
      "text": "10月6日后入神本身不额外提高基础锤速。",
      "status": "fact",
      "source_refs": [
        "S04"
      ],
      "reasoning": null
    },
    {
      "id": "C14",
      "text": "社区build资料记录基础入神窗口为4秒；本轮未验证当前原版时长。",
      "status": "fact",
      "source_refs": [
        "S15"
      ],
      "reasoning": null
    },
    {
      "id": "C15",
      "text": "社区入神资料记录窗口内仍存在Damage、Hold、Success和Great，因此免碎剑不等于必升级。",
      "status": "fact",
      "source_refs": [
        "S15"
      ],
      "reasoning": null
    },
    {
      "id": "C16",
      "text": "官方为新局提供免费三选一的起始遗物。",
      "status": "fact",
      "source_refs": [
        "S04"
      ],
      "reasoning": null
    },
    {
      "id": "C17",
      "text": "社区兑换资料记录任意等级的一把剑换1个遗物商店信用。",
      "status": "fact",
      "source_refs": [
        "S12"
      ],
      "reasoning": null
    },
    {
      "id": "C18",
      "text": "社区记录遗物架8槽；官方满槽提示要求先舍弃已有遗物。",
      "status": "fact",
      "source_refs": [
        "S12",
        "S08"
      ],
      "reasoning": null
    },
    {
      "id": "C19",
      "text": "官方合同长度为21个游戏内日，完成后可以继续锻造。",
      "status": "fact",
      "source_refs": [
        "S02"
      ],
      "reasoning": null
    },
    {
      "id": "C20",
      "text": "10月6日公告中的第21日基础纳贡要求为232,000G。",
      "status": "fact",
      "source_refs": [
        "S04"
      ],
      "reasoning": null
    },
    {
      "id": "C21",
      "text": "官方流程是放置贡品并摇铃结算，达标以贡品价值判断。",
      "status": "fact",
      "source_refs": [
        "S01",
        "S02"
      ],
      "reasoning": null
    },
    {
      "id": "C22",
      "text": "贡品不足会增加怒气，达到第三怒气阶段会致死；缓解效果可改变到达该阶段的过程。",
      "status": "fact",
      "source_refs": [
        "S02",
        "S03",
        "S17"
      ],
      "reasoning": null
    },
    {
      "id": "C23",
      "text": "10月6日恢复公告规定贡品不足后下一日仍获得3把基础剑。",
      "status": "fact",
      "source_refs": [
        "S05"
      ],
      "reasoning": null
    },
    {
      "id": "C24",
      "text": "社区资料记录献出的价值在结算后转为金币，成功或不足均有这一兑现渠道。",
      "status": "fact",
      "source_refs": [
        "S17"
      ],
      "reasoning": null
    },
    {
      "id": "C25",
      "text": "社区资料记录金币用于商人货物和遗物刷新，商人从第3日起每3日出现。",
      "status": "fact",
      "source_refs": [
        "S12",
        "S17"
      ],
      "reasoning": null
    },
    {
      "id": "C26",
      "text": "资料说明未献出的剑可跨游戏日保留；官方也修复了推进后铁砧未献出剑消失的问题。",
      "status": "fact",
      "source_refs": [
        "S02",
        "S12"
      ],
      "reasoning": null
    },
    {
      "id": "C27",
      "text": "官方遗物示例包括让Damage影响后续风险或Great收益、让Hold为后续Great积累收益。",
      "status": "fact",
      "source_refs": [
        "S04"
      ],
      "reasoning": null
    },
    {
      "id": "C28",
      "text": "恢复公告记录Undertaker's Chalice将碎剑峰值价值的30%作为废料放到贡台。",
      "status": "fact",
      "source_refs": [
        "S05"
      ],
      "reasoning": null
    },
    {
      "id": "C29",
      "text": "官方恢复公告说明Broken Holy Sword和Dawn Scabbard的继承效果可以组合。",
      "status": "fact",
      "source_refs": [
        "S05"
      ],
      "reasoning": null
    },
    {
      "id": "C30",
      "text": "官方确认碎剑后在具有撤销条件时存在恢复机会，并修复E使机会丢失的问题。",
      "status": "fact",
      "source_refs": [
        "S07"
      ],
      "reasoning": null
    },
    {
      "id": "C31",
      "text": "官方物品说明记录Incense of Oblivion可降低一阶段怒气，每局一次。",
      "status": "fact",
      "source_refs": [
        "S03"
      ],
      "reasoning": null
    },
    {
      "id": "C32",
      "text": "官方说明本局永久获得的票数可在舍弃来源遗物后保留，但新局重置。",
      "status": "fact",
      "source_refs": [
        "S04"
      ],
      "reasoning": null
    },
    {
      "id": "C33",
      "text": "官方说明图鉴发现跨局保留。",
      "status": "fact",
      "source_refs": [
        "S04"
      ],
      "reasoning": null
    },
    {
      "id": "C34",
      "text": "官方更新为成就添加了可解锁遗物，解锁后加入出现池。",
      "status": "fact",
      "source_refs": [
        "S03"
      ],
      "reasoning": null
    },
    {
      "id": "C35",
      "text": "开发者将持剑对龙战斗列为后续开发内容，11月为当时目标而非已上线事实。",
      "status": "fact",
      "source_refs": [
        "S09"
      ],
      "reasoning": null
    },
    {
      "id": "C36",
      "text": "开发者指出早期缺剑和连续破坏影响尝试，以及成型构筑后的重复体验仍需改进。",
      "status": "fact",
      "source_refs": [
        "S09"
      ],
      "reasoning": null
    },
    {
      "id": "C37",
      "text": "实际查看的官方铁砧截图同时显示剑名、等级、价值、五种概率、充能和最近结果。",
      "status": "fact",
      "source_refs": [
        "S10"
      ],
      "reasoning": null
    },
    {
      "id": "C38",
      "text": "当前留存商店截图显示3倍Great，与S04中的当前2.5倍规则不同，不能用截图数值替代更新规则。",
      "status": "fact",
      "source_refs": [
        "S10",
        "S04"
      ],
      "reasoning": null
