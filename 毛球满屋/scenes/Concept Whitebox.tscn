[sub_resource type="Shader" id="VignetteShader"]
code = "shader_type canvas_item;
render_mode unshaded;
uniform float strength : hint_range(0.0, 0.7) = 0.30;
uniform float inner_radius : hint_range(0.0, 1.0) = 0.45;
uniform float outer_radius : hint_range(0.5, 1.6) = 1.4;
void fragment() {
    float radius = length((UV - vec2(0.5)) * 2.0);
    float fade = smoothstep(inner_radius, outer_radius, radius);
    COLOR = vec4(0.035, 0.025, 0.018, fade * strength);
}
"

