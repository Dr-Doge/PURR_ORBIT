[sub_resource type="Shader" id="Shader_7ejkx"]
code = "shader_type spatial;
render_mode cull_disabled, specular_disabled;
uniform sampler2D art: source_color, filter_linear_mipmap_anisotropic, repeat_disable;
uniform vec4 region;
uniform bool top=false;
void fragment(){
 vec2 uv=top ? vec2(UV.y,UV.x) : UV;
 uv.x=fract(uv.x*2.0);
 vec4 c=texture(art,region.xy+uv*region.zw);
 if(c.a<0.4) discard;
 ALBEDO=c.rgb; ROUGHNESS=0.95;
}
"

